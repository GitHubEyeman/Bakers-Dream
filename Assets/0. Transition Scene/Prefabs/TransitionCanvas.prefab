  m_Script: {fileID: 11500000, guid: 961d36edb847164c09f5065e1ac9dfb6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneTransitioner
  designerNotes: '1. Create a button

    2. At OnClick() event for that button,
    Drag this TransitionCanvas prefab into the empty object slot.

    3.  Click
    the Dropdown Menu, scroll at the bottom at SceneTransitioner then click at TriggerTransition(string).

    4.
    Put the Scene name into the box next to it.

    5. Make sure that scene is in
    Unity''s Build Settings.'
  faderRectTransforms:
  - {fileID: 7056508808623648100}
  - {fileID: 988207912471437324}
  - {fileID: 4552157774703948527}
  baseSlideSpeed: 1.5
  speedMultiplierPerLayer: 0.3
  coveredXCoordinate: 0
  offscreenRightX: 60
  offscreenLeftX: -60
  timeSpentInBetween: 2
  skipInBetweenScene: 1
