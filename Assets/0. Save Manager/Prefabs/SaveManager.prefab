  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SaveManager
  designerNotes: 'To add or remove data that could be saved, edit SaveData.cs.

    This
    script will automatically saves the game on quit.

    Example To set a value
    from SaveData.cs :

    SaveManager.Instance.CurrentSave.highScore = 10;

    Example
    to retrieve said data:

    SaveManager.Instance.CurrentSave.highScore; <-- This
    can be assinged to variables'
  CurrentSave:
    highScore: 0
    unlockedLevel: 0
    scoreLevel1: 0
    scoreLevel2: 0
    scoreLevel3: 0
    scoreLevel4: 0
